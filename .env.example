# قاعدة بيانات PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# سر توقيع جلسات المصادقة (استبدله بسلسلة عشوائية طويلة في الإنتاج)
AUTH_SECRET="replace-with-a-strong-random-64-char-secret"

# مفاتيح Web Push اختيارية لإشعارات المتصفح والهاتف (تُولّد عبر: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:desk@betweenletters.app"

# سر اختياري لحماية مسار المهام المجدولة /api/dispatch عند استدعائه من Cron خارجي
CRON_SECRET=""
